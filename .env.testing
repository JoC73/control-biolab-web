APP_NAME="Control BIOLAB Testing"
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost

BIOLAB_STORAGE=json

DB_CONNECTION=sqlite
